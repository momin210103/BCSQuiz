<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BCSQuiz.Views.EditContactPage"
             Title="Edit Contact">
    <VerticalStackLayout Padding="16" Spacing="12">
        <!-- Existing label used by code-behind -->
        <Label 
            x:Name="lblName"
            Text="Edit Contact"
            FontSize="22"
            HorizontalOptions="Center" />

        <Frame Padding="16"
               CornerRadius="12"
               HasShadow="True"
               BackgroundColor="{AppThemeBinding Light='#FFFFFF', Dark='#1E1E1E'}">
            <VerticalStackLayout Spacing="12">

                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <Label Text="Name" WidthRequest="90" VerticalTextAlignment="Center" />
                    <Entry x:Name="entName"
                           Placeholder="Enter name"
                           HorizontalOptions="FillAndExpand" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <Label Text="Email" WidthRequest="90" VerticalTextAlignment="Center" />
                    <Entry x:Name="entEmail"
                           Placeholder="Enter email"
                           Keyboard="Email"
                           HorizontalOptions="FillAndExpand" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Frame>

        <HorizontalStackLayout Spacing="12" HorizontalOptions="End">
            <Button x:Name="cnlBtn" Text="Cancel" Clicked="cnlBtn_Clicked" />
            <Button x:Name="saveBtn" Text="Save" />
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>